{
  "name": "n8n-nodes-syncaty-salla",
  "version": "1.1.0",
  "description": "n8n community node for Salla e-commerce via Syncaty SaaS - Manage multiple Salla stores with centralized OAuth2 token management",
  "license": "MIT",
  "homepage": "https://syncaty.com",
  "author": {
    "name": "Syncaty",
    "email": "support@syncaty.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncaty/n8n-nodes-syncaty-salla.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SyncatyOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SyncatySalla/SyncatySalla.node.js",
      "dist/nodes/SyncatySalla/SyncatySallaTrigger.node.js",
      "dist/nodes/SyncatySalla/SyncatySallaWebhook.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.20.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "salla",
    "syncaty",
    "e-commerce",
    "oauth2",
    "automation",
    "saudi-arabia",
    "middle-east",
    "multi-store"
  ]
}
